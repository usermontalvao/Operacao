HOST=127.0.0.1
PORT=3010
TRADING_MODE=PAPER

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Gere com: openssl rand -hex 32
APP_SECRET=

# Segunda chave da compra automática em conta REAL.
# Só com isto em "true" o painel consegue armar o robô para dinheiro de verdade
# — e o armamento do painel ainda vence sozinho. Duas travas independentes:
# uma que ninguém desfaz por engano na tela, outra que se apaga com o tempo.
ALLOW_LIVE_AUTOTRADE=false

# Hosts aceitos nas chamadas da API. Em branco assume localhost na porta acima.
# Impede que uma página qualquer aponte um domínio para 127.0.0.1 e converse
# com esta API — que é a API que envia ordem.
ALLOWED_HOSTS=

STORE=json
DATA_DIR=data
# ---------------------------------------------------------------------------
# Supabase (opcional). Enquanto STORE=json acima, NADA aqui é usado: o sistema
# continua gravando em data/*.json. Para migrar, preencha as três linhas e
# troque STORE=json por STORE=supabase.
#   SUPABASE_URL ............. https://SEU-PROJETO.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY  chave "service_role" (Project Settings > API).
#                              É a chave que ignora RLS — ela só pode existir
#                              aqui, no servidor. Nunca no navegador.
#   SUPABASE_OWNER_ID ........ uuid do dono dos dados (em branco = uuid zero)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_OWNER_ID=

# Só para o comando de migração (npm run migrar). É o token PESSOAL da conta,
# gerado em https://supabase.com/dashboard/account/tokens — a única chave com
# direito a criar tabela. A service_role acima NÃO serve: ela fala com o
# PostgREST, que não executa DDL.
# Sem ele existe o caminho manual: npm run migrar -- --print > migracao.sql
# e colar no SQL Editor do projeto.
SUPABASE_ACCESS_TOKEN=
# Em branco = deduzido do SUPABASE_URL.
SUPABASE_PROJECT_REF=

# ---------------------------------------------------------------------------
# Login do painel. Não existe modo "sem login": sem isto preenchido a API
# recusa tudo e a tela só mostra como configurar. Esta é a API que envia ordem.
#
#   npm run senha    pergunta usuário e senha e preenche as duas linhas abaixo
#   npm run usuario  cria a conta no Supabase Auth (necessária quando STORE=supabase,
#                    porque as tabelas apontam para auth.users)
#
# AUTH_BACKEND=auto  hash local vence; sem ele, confere no Supabase Auth
#              local  confere o PANEL_PASSWORD_HASH deste arquivo
#              supabase  confere a senha no Supabase Auth (não guarda hash aqui)
# ---------------------------------------------------------------------------
PANEL_USER=
PANEL_PASSWORD_HASH=
AUTH_BACKEND=auto
# Quanto tempo a sessão dura sem pedir senha de novo.
SESSION_HOURS=12
WATCHLIST=BTCUSDT,ETHUSDT,XRPUSDT,OPUSDT,ONDOUSDT
LOG_LEVEL=info
