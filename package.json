{
  "name": "crypto-setup-hunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --watch src/server/index.ts",
    "dev:web": "vite",
    "start": "node --env-file-if-exists=.env src/server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "senha": "node --env-file-if-exists=.env scripts/senha.mjs",
    "usuario": "node --env-file-if-exists=.env scripts/usuario.mjs",
    "migrar": "node --env-file-if-exists=.env scripts/migrar.mjs",
    "migrar-dados": "node --env-file-if-exists=.env scripts/migrar-dados.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lightweight-charts": "^5.2.1",
    "ws": "^8.18.0",
    "zod": "^4.0.5"
  },
  "optionalDependencies": {
    "@supabase/supabase-js": "^2.58.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^5.0.0",
    "@types/node": "^24.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
